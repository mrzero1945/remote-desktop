<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ipInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ip_hint"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:background="@drawable/edit_bg"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/portInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/port_hint"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:background="@drawable/edit_bg"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/connect"
                android:textColor="#000000" />

            <Button
                android:id="@+id/scanBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/scan"
                android:textColor="#000000" />

            <Button
                android:id="@+id/fullscreenBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/fullscreen"
                android:textColor="#000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ToggleButton
                android:id="@+id/fecToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:checked="true"
                android:textOn="@string/fec_toggle"
                android:textOff="@string/fec_toggle" />

            <ToggleButton
                android:id="@+id/arqToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:checked="true"
                android:textOn="@string/arq_toggle"
                android:textOff="@string/arq_toggle" />

            <ToggleButton
                android:id="@+id/gpuToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:checked="true"
                android:textOn="@string/gpu_toggle"
                android:textOff="@string/gpu_toggle" />

            <ToggleButton
                android:id="@+id/audioToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:checked="true"
                android:textOn="@string/audio_toggle"
                android:textOff="@string/audio_toggle" />

            <ToggleButton
                android:id="@+id/sslToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:checked="true"
                android:textOn="@string/ssl_toggle"
                android:textOff="@string/ssl_toggle" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/not_connected"
        android:textColor="#9CCC65"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.remotedesktop.client.RemoteView
            android:id="@+id/remoteView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/kbFloatBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/btn_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/kb_keyboard"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                android:elevation="6dp" />

            <TextView
                android:id="@+id/exitFullscreenBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/btn_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/exit_fullscreen"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                android:elevation="6dp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/logHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A2A2A"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/log_header"
        android:textColor="#80CBC4"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/logList"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#121212"
        android:divider="#333333"
        android:dividerHeight="1dp" />
</LinearLayout>